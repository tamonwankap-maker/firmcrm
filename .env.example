# ── Copy to .env and fill in. Never commit .env. ──

# Local development (docker-compose.dev.yml)
DATABASE_URL="postgresql://bdcrm:bdcrm@localhost:5432/bdcrm?schema=public"

# Generate with: openssl rand -base64 48
AUTH_SECRET=""
# Public URL users open in the browser
AUTH_URL="http://localhost:3000"

# First admin account, created only if no admin exists yet.
SEED_ADMIN_EMAIL="head.of.bd@yourfirm.com"
SEED_ADMIN_PASSWORD=""

# ── Production (docker-compose.yml) ──
POSTGRES_PASSWORD=""
APP_PORT=3000
BACKUP_KEEP_DAYS=30
# Nightly backup time (hour, Bangkok time)
BACKUP_HOUR=2
