    "@prisma/client": "^7.10.1",
    "@react-pdf/renderer": "^4.9.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
